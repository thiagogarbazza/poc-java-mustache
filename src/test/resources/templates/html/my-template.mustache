<!DOCTYPE html>
<html lang="en" id="{{id}}" date-time="{{dateTime}}">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{title}}</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
    }

    .content {
      max-width: 800px;
      margin: 0 auto;
      padding: 20px;
    }

    .table-responsive {
      overflow-x: auto;
    }

    .table {
      width: 100%;
      border-collapse: collapse;
    }

    .table th, .table td {
      border: 1px solid #ddd;
      padding: 8px;
    }

    .table th {
      background-color: #f2f2f2;
      text-align: left;
    }
  </style>
</head>
<body>
<div class="content">
  {{> header}}

  <div class="table-responsive">
    <table class="table">
      <thead>
      <tr>
        <th>Document</th>
        <th>Status</th>
      </tr>
      </thead>
      <tbody>
      {{#documents}}
        <tr>
          <td>{{code}}</td>
          <td>{{status}}</td>
        </tr>
      {{/documents}}
      </tbody>
    </table>
  </div>

  {{> footer}}
</div>
</body>
</html>
